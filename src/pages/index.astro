---
// 1. Import your CSS file at the top of the file inside the frontmatter (the --- lines)
import '../styles/global.css'; 
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AFKDadTv | Official Hub</title>
    
    <!-- SEO & Rich Social Media Preview Cards (OpenGraph) -->
    <meta name="description" content="Official hub for AFKDadTv. Streamer, Dad, Content Creator. Grab the Minecraft server IP, find my socials, and join the community!">
    <meta property="og:title" content="AFKDadTv | Official Hub">
    <meta property="og:description" content="Balancing Dad life and gaming. Catch live streams, view YouTube videos, and join the official server community!">
    <meta property="og:image" content="https://afkdadtv.com">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Browser Tab Bar Icon (Favicon) -->
    <link rel="icon" type="image/png" href="/Logo.png" />

    <!-- Official CDN for your social icons -->
    <link rel="stylesheet" href="/styles/global.css">
</head>
<body>

    <div class="container">
        <!-- Profile Header -->
        <header class="profile-header">
            <div class="logo-container">
                <img src="/Logo.png" alt="AFKDadTv Logo" class="profile-logo" onerror="this.src='https://afkdadtv.com'">
                <!-- Live indicator dot that changes via script -->
                <div class="live-dot" id="twitch-indicator"></div>
            </div>
            <h1>AFKDadTv</h1>
            <p class="tagline" id="stream-status-text">Streamer | Content Creator | Dad</p>
        </header>

        <!-- About Section -->
        <section class="about-section">
            <h2>About Me</h2>
            <p>Welcome to the official hub! I'm AFKDadTv, balancing the chaos of dad life with a passion for gaming and content creation. Whether I'm streaming live or dropping new videos, this is the ultimate spot to keep up with the journey. Drop a follow, join the community, and let's hang out!</p>
        </section>

        <!-- Social Links Buttons -->
        <section class="links-section">
            <h2>Connect With Me</h2>
            
            <a href="https://twitch.tv/afkdadtv" target="_blank" class="social-card twitch" id="twitch-link">
                <i class="fab fa-twitch"></i>
                <div class="btn-text-wrapper">
                    <span>Twitch</span>
                    <span class="live-subtext" id="twitch-subtext">● Stream Currently Offline</span>
                </div>
            </a>

            <a href="https://youtube.com/@afkdadtv" target="_blank" class="social-card youtube">
                <i class="fab fa-youtube"></i>
                <span>YouTube</span>
            </a>
            
            <a href="https://instagram.com/afkdadtv" target="_blank" class="social-card instagram">
                <i class="fab fa-instagram"></i>
                <span>Instagram</span>
            </a>

            <a href="https://facebook.com/afkdadtv" target="_blank" class="social-card facebook">
                <i class="fab fa-facebook-f"></i>
                <span>Facebook</span>
            </a>
            
            <a href="https://discord.gg/rqwJ5KAHqZ" target="_blank" class="social-card discord">
                <i class="fab fa-discord"></i>
                <span>Join the Discord</span>
            </a>

            <!-- Minecraft Server Copy Button -->
            <button class="social-card minecraft-card" id="copy-mc-btn" data-ip="mc.afkdadserver.com">
                <div class="btn-content">
                    <i class="fas fa-cube"></i>
                    <div class="text-group">
                        <span class="main-text">Minecraft Server</span>
                        <span class="sub-text" id="btn-subtext">mc.afkdadserver.com</span>
                    </div>
                </div>
                <!-- Overlay message container -->
                <div class="hover-tooltip" id="mc-tooltip">Click to Copy URL</div>
            </button>
        </section>

        <!-- Footer -->
        <footer>
            <p>&copy; 2026 AFKDadTv. All rights reserved.</p>
        </footer>
    </div>
    <!-- Script Handling Automated Counter + Clipboard Engine -->
    <script is:inline>
        (function() {
            // --- 1. MINECRAFT SERVER CLIPBOARD AUTOMATION ---
            const copyBtn = document.getElementById('copy-mc-btn');
            const tooltip = document.getElementById('mc-tooltip');
            const mcSubtext = document.getElementById('btn-subtext');

            if (copyBtn && tooltip) {
                copyBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const cleanIP = "mc.afkdadserver.com";

                    function showSuccess() {
                        tooltip.textContent = 'Copied to Clipboard!';
                        copyBtn.classList.add('copied');
                        setTimeout(function() {
                            tooltip.textContent = 'Click to Copy URL';
                            copyBtn.classList.remove('copied');
                        }, 2000);
                    }

                    if (navigator.clipboard && window.ClipboardItem) {
                        const item = new ClipboardItem({ "text/plain": Promise.resolve(cleanIP) });
                        navigator.clipboard.write([item]).then(function() {
                            showSuccess();
                        }).catch(function(err) {
                            fallbackCopy(cleanIP);
                        });
                    } else {
                        fallbackCopy(cleanIP);
                    }

                    function fallbackCopy(text) {
                        const textArea = document.createElement("textarea");
                        textArea.value = text;
                        textArea.style.position = 'absolute';
                        textArea.style.opacity = '0';
                        textArea.style.fontSize = '16px';
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        textArea.setSelectionRange(0, 99999);
                        try {
                            const successful = document.execCommand('copy');
                            if (successful) {
                                showSuccess();
                            } else {
                                tooltip.textContent = 'Tap to select text';
                            }
                        } catch (err) {
                            tooltip.textContent = 'Not supported!';
                        }
                        document.body.removeChild(textArea);
                    }
                });
            }

            // --- 2. FIXED HARDCODED MINECRAFT PLAYER COUNTER ---
            // HARDCODED URL: Completely removed variables to ensure absolute path resolution stability
            fetch('https://api.mcstatus.io/v2/status/java/mc.afkdadserver.com')
            .then(res => {
                if (!res.ok) throw new Error('API down');
                return res.json();
            })
            .then(data => {
                if (data && data.online && mcSubtext) {
                    const onlinePlayers = (data.players && data.players.online) || 0;
                    const maxPlayers = (data.players && data.players.max) || 20;
                    mcSubtext.textContent = `● Online Now: ${onlinePlayers}/${maxPlayers} players`;
                    mcSubtext.style.color = "#55ff55";
                } else if (mcSubtext) {
                    mcSubtext.textContent = "mc.afkdadserver.com";
                    mcSubtext.style.color = "#a9a9a9";
                }
            })
            .catch(() => {
                if (mcSubtext) {
                    mcSubtext.textContent = "mc.afkdadserver.com";
                    mcSubtext.style.color = "#a9a9a9";
                }
            });

            // --- 3. HARDCODED TWITCH LIVE/OFFLINE CONTROLLER (DECAPI PATCH) ---
            const indicator = document.getElementById('twitch-indicator');
            const statusText = document.getElementById('stream-status-text');
            const twitchSub = document.getElementById('twitch-subtext');

            if (twitchSub) {
                twitchSub.textContent = "● Stream Currently Offline";
                twitchSub.style.color = "#ff4a4a";
            }

            // Swapped tracking route to point to decapi's robust public uptime tracker node directly
            fetch('https://decapi.me/twitch/uptime/afkdadtv')
                .then(res => {
                    if (!res.ok) throw new Error('API down');
                    return res.text();
                })
                .then(uptimeText => {
                    // If the text response does NOT say offline, you are streaming live!
                    if (uptimeText && !uptimeText.toLowerCase().includes('offline')) {
                        if (indicator) indicator.classList.add('active-live');
                        if (statusText) statusText.innerHTML = `<span style="color:#55ff55; font-weight:bold;">🔴 LIVE NOW ON TWITCH</span>`;
                        if (twitchSub) {
                            twitchSub.textContent = `🔴 Live Now - Streaming for ${uptimeText}`;
                            twitchSub.style.color = "#55ff55"; // Turns font green
                        }
                    } else {
                        if (indicator) indicator.classList.remove('active-live');
                        if (statusText) statusText.textContent = "Streamer | Content Creator | Dad";
                        if (twitchSub) {
                            twitchSub.textContent = "● Stream Currently Offline";
                            twitchSub.style.color = "#ff4a4a"; // Font stays red
                        }
                    }
                })
                .catch(() => {
                    if (twitchSub) {
                        twitchSub.textContent = "● Stream Currently Offline";
                        twitchSub.style.color = "#ff4a4a";
                    }
                });
        })();
    </script>
</body>
</html>
