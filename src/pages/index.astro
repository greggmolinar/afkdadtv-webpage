---
// 1. Import your CSS file at the top of the file inside the frontmatter (the --- lines)
import '../styles/global.css'; 
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AFKDadTv | Official Hub</title>
    <!-- FontAwesome for Social Icons -->
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body>

    <div class="container">
        <!-- Profile Header -->
        <header class="profile-header">
            <div class="logo-container">
                <!-- If you have a logo image, put it in the /public folder and reference it as /logo.png -->
                <img src="/Logo.png" alt="AFKDadTv Logo" class="profile-logo" onerror="this.src='https://placeholder.com'">
            </div>
            <h1>AFKDadTv</h1>
            <p class="tagline">Streamer | Content Creator | Dad</p>
        </header>

        <!-- About Section -->
        <section class="about-section">
            <h2>About Me</h2>
            <p>Welcome to the official hub! I'm AFKDadTv, balancing the chaos of dad life with a passion for gaming and content creation. Whether I'm streaming live or dropping new videos, this is the ultimate spot to keep up with the journey. Drop a follow, join the community, and let's hang out!</p>
        </section>

        <!-- Social Links Buttons -->
        <section class="links-section">
            <h2>Connect With Me</h2>
            
            <a href="https://twitch.tv/afkdadtv" target="_blank" class="social-card twitch">
                <i class="fab fa-twitch"></i>
                <span>Twitch</span>
            </a>

            <a href="https://youtube.com/@afkdadtv" target="_blank" class="social-card youtube">
                <i class="fab fa-youtube"></i>
                <span>YouTube</span>
            </a>

            <a href="https://instagram.com/afkdadtv" target="_blank" class="social-card instagram">
                <i class="fab fa-instagram"></i>
                <span>Instagram</span>
            </a>

            <a href="https://facebook.com/afkdadtv" target="_blank" class="social-card facebook">
                <i class="fab fa-facebook-f"></i>
                <span>Facebook</span>
            </a>
            <!-- Minecraft Server Copy Button -->
<button class="social-card minecraft-card" id="copy-mc-btn" data-ip="mc.afkdadtvserver.com">
    <div class="btn-content">
        <i class="fas fa-cube"></i>
        <div class="text-group">
            <span class="main-text">Minecraft Server</span>
            <span class="sub-text" id="btn-subtext">mc.afkdadtvserver.com</span>
        </div>
    </div>
    <!-- Overlay message container -->
    <div class="hover-tooltip" id="mc-tooltip">Click to Copy URL</div>
</button>

        </div>
    </div>
</button>
<script is:inline>
    (function() {
        const copyBtn = document.getElementById('copy-mc-btn');
        const tooltip = document.getElementById('mc-tooltip');

        if (copyBtn && tooltip) {
            copyBtn.addEventListener('click', function(e) {
                // Prevent any default form or link behavior
                e.preventDefault();
                e.stopPropagation();
                
                // Hardcoded clean URL string to guarantee no HTML code is copied
                const cleanIP = "://afkdadtvserver.com";
                
                // Force copy command to clipboard
                navigator.clipboard.writeText(cleanIP).then(function() {
                    // Update overlay text to show success prompt
                    tooltip.textContent = 'Copied to Clipboard!';
                    copyBtn.classList.add('copied');
                    
                    // Reset back to original hover message layout after 2 seconds
                    setTimeout(function() {
                        tooltip.textContent = 'Click to Copy URL';
                        copyBtn.classList.remove('copied');
                    }, 2000);
                }).catch(function(err) {
                    console.error('Failed to copy text: ', err);
                    tooltip.textContent = 'Failed to copy!';
                });
            });
        }
    })();
</script>

        </section>

        <!-- Footer -->
        <footer>
            <p>&copy; 2026 AFKDadTv. All rights reserved.</p>
        </footer>
    </div>

</body>
</html>
